# GEMINI_API_KEY: Required for Gemini AI (Crop Doctor vision + Rythu Nestham assistant).
# Get a key at https://aistudio.google.com/apikey
# Model used in code: gemini-2.0-flash (vision + text).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this app is hosted (optional for local).
APP_URL="MY_APP_URL"

# DATA_GOV_API_KEY: Optional API key for data.gov.in Agmarknet live APMC mandi prices.
DATA_GOV_API_KEY=""

# Google Earth Engine (COPERNICUS/S2_SR_HARMONIZED Sentinel-2 pixel NDVI/NDWI/EVI/SAVI)
# 1. Create a GCP project and enable Earth Engine API (earthengine.googleapis.com).
# 2. Create a service account and download its JSON key.
# 3. Register that service account with Earth Engine:
#    https://earthengine.google.com/ → register project / service account access.
# 4. Set either the full JSON string OR the split email + private key.
GEE_PROJECT_ID=""
GEE_SERVICE_ACCOUNT_JSON=""
# Alternative to GEE_SERVICE_ACCOUNT_JSON (paste private key with real newlines or \n):
# GEE_CLIENT_EMAIL=""
# GEE_PRIVATE_KEY=""
