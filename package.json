{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "predev": "node -e \"const fs=require('fs');const p=['server_part_0.ts.txt','server_part_1.ts.txt','server_part_2.ts.txt'];if(p.every(f=>fs.existsSync(f)))fs.writeFileSync('server.ts',p.map(f=>fs.readFileSync(f,'utf8')).join(''));\"",
    "dev": "tsx server.ts",
    "prestart": "node -e \"const fs=require('fs');const p=['server_part_0.ts.txt','server_part_1.ts.txt','server_part_2.ts.txt'];if(p.every(f=>fs.existsSync(f)))fs.writeFileSync('server.ts',p.map(f=>fs.readFileSync(f,'utf8')).join(''));\"",
    "start": "tsx server.ts",
    "build": "vite build",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "reconstruct-server": "node -e \"const fs=require('fs');const p=['server_part_0.ts.txt','server_part_1.ts.txt','server_part_2.ts.txt'];fs.writeFileSync('server.ts',p.map(f=>fs.readFileSync(f,'utf8')).join(''));console.log('server.ts reconstructed',fs.statSync('server.ts').size)\""
  },
  "dependencies": {
    "@google/earthengine": "^1.7.52",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "three": "^0.187.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
